        {
          "name": "Create Image (Upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data) {",
                  "  pm.collectionVariables.set(\"new_image_id\", json.data.image_id);",
                  "  console.log(\"Saved new_image_id = \" + json.data.image_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "Select image file (jpg/png/gif/webp, max 20MB)",
                  "value": null
                },
                {
                  "key": "image_name",
                  "value": "My First Image",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Uploaded from Postman",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/images",
              "host": ["{{base_url}}"],
              "path": ["images"]
            }
          },
          "response": []
        },
